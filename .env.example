# ============================================================
# Environment
# ============================================================
ENVIRONMENT=development

# ============================================================
# AWS S3 Configuration
# ============================================================
S3_BUCKET_NAME=my-dataset-bucket
S3_BASE_PREFIX=Project_Data
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Optional: Endpoint URL for MinIO, Cloudflare R2, Wasabi, etc.
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com

# ============================================================
# Benchmark Configuration
# ============================================================
# Số ảnh tối đa lấy từ mỗi thư mục nhóm trên S3 (vd: 100 ảnh/nhóm x 4 nhóm = 400 ảnh/lần chạy)
IMAGES_PER_GROUP=100

# Tổng số lần chạy benchmark (mỗi lần = toàn bộ ảnh trên S3)
TOTAL_RUNS=5

# ============================================================
# Crawl Configuration
# ============================================================
TARGET_IMAGES_PER_GROUP=100
