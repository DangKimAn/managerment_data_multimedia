# ============================================================
# Environment
# ============================================================
ENVIRONMENT=development

# ============================================================
# AWS S3 Configuration
# ============================================================
S3_BUCKET_NAME=your-dataset-bucket
S3_BASE_PREFIX=Project_Data
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Optional endpoint for MinIO, Cloudflare R2, Wasabi, etc.
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# ============================================================
# Benchmark Configuration
# ============================================================
# Maximum images loaded from each S3 image group.
IMAGES_PER_GROUP=100

# Number of complete benchmark runs.
TOTAL_RUNS=5

# ============================================================
# Dataset Crawl Configuration
# ============================================================
TARGET_IMAGES_PER_GROUP=100
